# mock — код в консоли (разработка, по умолчанию)
# smsru — https://sms.ru (+7, +375)
# smsc  — https://smsc.ru
# twilio — международный
SMS_PROVIDER=mock

# Публичный URL после деплоя (https://api.ваш-домен.ru)
PUBLIC_URL=

# sms.ru → Панель → API
SMSRU_API_ID=
# необязательно: имя отправителя (если одобрено)
SMSRU_FROM=

# smsc.ru
SMSC_LOGIN=
SMSC_PASSWORD=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
